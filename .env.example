# OpenRouter API key — single cloud AI gateway for AnimaStage Lite
# Create at: https://openrouter.ai/keys
# You can also paste the key in Pro tools / AI Studio (saved in localStorage only).
VITE_OPENROUTER_API_KEY=

# NVIDIA NIM / Integrate API key — optional for AI Scene Director
# Create at: https://build.nvidia.com/ (nvapi-…)
# Or paste in AI Scene Director → NVIDIA (saved in localStorage only).
VITE_NVIDIA_API_KEY=

# Optional: WebRTC signaling (comma-separated). Default: w-webrtc-eu.fly.dev only.
# VITE_COLLAB_SIGNALING=wss://your-signaling.example.com
